# Copy to .env and fill in values (never commit .env)

MONGODB_URI=mongodb+srv://<username>:<password>@cluster1.r5ppus8.mongodb.net/taskflow_ai?retryWrites=true&w=majority

JWT_SECRET=your-256-bit-secret-key-here-change-in-production-min-32-chars
JWT_EXPIRATION_MS=86400000

# Google login + Gmail — https://console.cloud.google.com/apis/credentials
# Redirect URIs (add BOTH in Google Cloud Console):
#   http://localhost:8080/login/oauth2/code/google
#   http://localhost:8080/login/oauth2/code/google-gmail
GOOGLE_OAUTH_ENABLED=true
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# AI Provider Configuration
# Supported providers: gemini, openai
AI_PROVIDER=gemini
AI_API_KEY=your-ai-api-key-here
AI_MODEL=gemini-2.5-flash
# Optional: Override default base URL
# AI_BASE_URL=
